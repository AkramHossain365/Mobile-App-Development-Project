<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPaymentDetails"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Payment Details"
        app:titleTextColor="@android:color/white"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:id="@+id/tvPaymentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment #1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>


            <TextView
                android:text="Payment Type"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvPaymentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Description"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvPaymentDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Amount"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvPaymentAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="৳ 0.00"
                android:textColor="#0B6B3A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Payment Method"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Transaction Reference"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvPaymentReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:id="@+id/tvPaymentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Paid"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="14dp"/>


            <TextView
                android:id="@+id/tvPaymentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingTop="12dp"/>


            <TextView
                android:id="@+id/tvPaymentUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>