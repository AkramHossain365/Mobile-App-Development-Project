<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Header Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DUET HALL PORTAL"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#005B96"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Home Dashboard"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Grid / Menu Buttons -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins">

        <!-- Notice Board Button -->
        <Button
            android:id="@+id/btnNotice"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="Notice Board"
            android:textSize="16sp"
            android:backgroundTint="#005B96" />

        <!-- Seat Management Button -->
        <Button
            android:id="@+id/btnSeatInfo"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="Seat Info"
            android:textSize="16sp"
            android:backgroundTint="#005B96" />

        <!-- Dining System Button -->
        <Button
            android:id="@+id/btnDining"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="Dining System"
            android:textSize="16sp"
            android:backgroundTint="#005B96" />

        <!-- Complain Box Button -->
        <Button
            android:id="@+id/btnComplain"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="Complain Box"
            android:textSize="16sp"
            android:backgroundTint="#005B96" />

    </GridLayout>

</LinearLayout>