<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarApplicationDetails"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Application Details"
        app:titleTextColor="@android:color/white"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:id="@+id/tvApplicationId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Application #1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>


            <TextView
                android:text="Application Type"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvApplicationType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Subject"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvApplicationSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Reason"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvApplicationReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="16dp"/>


            <TextView
                android:text="Additional Details"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <TextView
                android:id="@+id/tvApplicationDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="20dp"/>


            <TextView
                android:id="@+id/tvApplicationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Pending"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="14dp"/>


            <TextView
                android:id="@+id/tvApplicationCreatedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submitted: 26 Aug 2026"
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingTop="12dp"/>


            <TextView
                android:id="@+id/tvApplicationUpdatedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: 26 Aug 2026"
                android:textColor="#777777"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>